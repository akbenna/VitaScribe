[Unit]
# VitaScribe - zelflerende jobs (vocabulaire + few-shot)
Description=VitaScribe zelflerende jobs (vocabulaire + few-shot)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
# Pas User/WorkingDirectory aan naar de installatie op de praktijkserver
User=vitascribe
WorkingDirectory=/opt/vitascribe
# Het wrapper-script laadt zelf .env en kiest de venv-python
ExecStart=/opt/vitascribe/scripts/run_learning_jobs.sh
Nice=10
# Beveiliging: minimale rechten
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
