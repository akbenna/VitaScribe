# =============================================================================
# VitaScribe Cloud API - Railway Deployment
# =============================================================================
# Lightweight API server: no GPU, no ML models.
# STT via Deepgram/Groq, LLM via Mistral/Claude - all cloud API calls.
# =============================================================================

FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install only cloud API dependencies (lightweight)
COPY services/cloud_api/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy cloud API code + ensure __init__.py exists
COPY services/cloud_api/ /app/services/cloud_api/
RUN touch /app/services/__init__.py /app/services/cloud_api/__init__.py

ENV PYTHONPATH="/app"

HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8002}/health || exit 1

EXPOSE ${PORT:-8002}

CMD uvicorn services.cloud_api.main:app --host 0.0.0.0 --port ${PORT:-8002}
