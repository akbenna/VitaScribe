# =============================================================================
# AI-Consultassistent — Environment Configuration
# =============================================================================
# Kopieer naar .env en pas aan voor jouw omgeving.
# BEWAAR DIT BESTAND NOOIT IN VERSIEBEHEER MET INGEVULDE WAARDEN.
# =============================================================================

# --- Algemeen ---
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- Database (PostgreSQL) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=consultassistent
POSTGRES_USER=ca_app
POSTGRES_PASSWORD=CHANGE_ME
# Encryptie-sleutel voor pgcrypto kolommen (AES-256)
DB_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME

# --- Whisper STT ---
# GPU (productie):  large-v3-turbo + cuda + float16
# CPU (testen):     small + cpu + int8  (of "medium" voor beter NL)
WHISPER_MODEL=large-v3-turbo
WHISPER_MODEL_CPU=small
WHISPER_MODEL_PATH=/models/whisper
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=nl
WHISPER_BEAM_SIZE=5
# Medische context-biasing en naberekening (zie shared/vocabulary.py)
WHISPER_USE_INITIAL_PROMPT=true
WHISPER_USE_HOTWORDS=true
WHISPER_POSTCORRECT=true
# Geleerde correcties uit de feedbackloop (custom woordenlijst)
WHISPER_CUSTOM_VOCAB_PATH=/data/vocabulary/custom_vocabulary.json

# --- Zelflerende laag: vocabulaire-job (niveau 1) ---
VOCAB_LEARN_MIN_CONFIRMATIONS=3
VOCAB_LEARN_MIN_DOMINANCE=0.6
VOCAB_LEARN_PERSIST_FLOOR=2

# --- Zelflerende laag: dynamische few-shot uit goedgekeurde SOEP's (niveau 2) ---
FEWSHOT_ENABLED=true
FEWSHOT_BANK_PATH=/data/fewshot/soep_examples.json
FEWSHOT_K=3
FEWSHOT_MAX_EXAMPLES=500

# --- Fase 3: forced-alignment (WhisperX) ---
WHISPER_USE_FORCED_ALIGNMENT=false
WHISPER_ALIGNMENT_DEVICE=cuda

# --- Fase 3: trainingsdata-export (zie docs/FASE3_FINETUNING.md) ---
ASR_DATASET_PATH=/data/training/asr_correction.jsonl
ASR_MIN_PAIRS=200
DPO_DATASET_PATH=/data/training/soep_dpo.jsonl
DPO_MIN_PAIRS=200

# --- Diarisatie (PyAnnote) ---
DIARIZATION_ENABLED=true
# HuggingFace token nodig voor PyAnnote model download
HF_TOKEN=CHANGE_ME

# --- Ollama (LLM — draait lokaal als Docker service) ---
# docker-compose.yml overschrijft dit automatisch met http://ollama:11434
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
# Fallback model (optioneel, vereist ≥24GB VRAM)
OLLAMA_FALLBACK_MODEL=
OLLAMA_TIMEOUT=120

# --- Cloud Fallback (standaard UIT) ---
CLOUD_FALLBACK_ENABLED=false
# Alleen Europees gehoste API's
CLOUD_FALLBACK_PROVIDER=mistral
CLOUD_FALLBACK_API_KEY=
CLOUD_FALLBACK_API_URL=https://api.mistral.ai/v1
# Drempel: confidence onder deze waarde triggert fallback-optie
CLOUD_FALLBACK_CONFIDENCE_THRESHOLD=0.6

# --- Audio Capture ---
AUDIO_SAMPLE_RATE=16000
AUDIO_FORMAT=wav
AUDIO_MAX_DURATION_SECONDS=3600
# Pad voor tijdelijke audio-opslag (encrypted volume)
AUDIO_STORAGE_PATH=/data/audio

# --- Export ---
HIS_EXPORT_MODE=clipboard
# HIS_EXPORT_API_URL=  # Indien API-koppeling beschikbaar

# --- Audit ---
AUDIT_LOG_RETENTION_YEARS=5
AUDIT_LOG_PATH=/data/audit

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=AI-Consultassistent

# --- Beveiliging ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# =============================================================================
# VitaScribe Cloud API — Chrome Extension Backend
# =============================================================================
# Lichtgewichte cloud API die de Chrome Extension bedient.
# Kan los draaien (zonder PostgreSQL/Redis/Ollama).

# --- API Server ---
API_HOST=0.0.0.0
API_PORT=8002
# Komma-gescheiden API keys voor multi-tenant auth
API_KEYS=
# Zonder sleutels en zonder register weigert de server alles. Alleen voor lokale
# ontwikkeling: VITASCRIBE_OPEN=1 laat dan elk verzoek toe. Nooit in productie.
VITASCRIBE_OPEN=
CORS_ORIGINS=chrome-extension://,http://localhost:3000
MAX_AUDIO_MB=50
# Live consult: maximale duur in seconden (kostenrem voor een vergeten microfoon)
CONSULT_LIVE_MAX_SECONDS=2700

# --- Cloud API (services/cloud_api): modus en testgereedschap ---
# Standaardmodus is "eu" (sinds 2.21.1). TOEGESTANE_MODI=eu sluit de Claude-modus
# (Deepgram, Anthropic, VS) helemaal uit: zet dit in productie zolang die partijen
# niet onder een verwerkersovereenkomst vallen (docs/dossier/05-subverwerkers.md).
TOEGESTANE_MODI=eu
# Spraaktest, SOEP-test en testset zet de beheerder zelf aan en uit in Beheer,
# onder Instellingen (standaard uit). Daar is geen omgevingsvariabele voor.

# --- STT Providers (kies één als default) ---
STT_PROVIDER=groq
# Groq (gratis, 14.400 sec/dag)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
# Deepgram (beste NL, ~€0.0043/min)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=nl
# OpenAI Whisper (~€0.006/min)
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1

# --- Live dicteren (zijpaneel Chrome-extensie) ---
# Gebruikt altijd Deepgram streaming met DEEPGRAM_API_KEY hierboven.
# Nova-3 live ~$0.0077/min; medicatienamen als keyterms ~$0.0013/min extra.
DICTATION_DEEPGRAM_MODEL=nova-3
DICTATION_LANGUAGE=nl
# EU-endpoint (verwerking blijft in de EU, zelfde API-sleutel). Globaal: wss://api.deepgram.com/v1/listen
DICTATION_DEEPGRAM_URL=wss://api.eu.deepgram.com/v1/listen
# Stilte (ms) waarna een zin als definitief geldt; lager = sneller, maar knipt eerder.
DICTATION_ENDPOINTING_MS=300
DICTATION_KEYTERMS=true
# Kostenbewaking: open microfoon stopt automatisch na deze duur.
DICTATION_MAX_SECONDS=600

# --- LLM Providers (kies één als default) ---
# Omschakelen naar Claude: zet LLM_PROVIDER=anthropic + vul ANTHROPIC_API_KEY.
# Haiku is de goedkoopste Claude; let op AVG (VS) → regel zero-retention/DPA.
LLM_PROVIDER=mistral
# Mistral (EU/Parijs, AVG-veilig, $0.10/$0.30 per 1M in/out)
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# Anthropic Claude Haiku 4.5 (goedkoopste Claude, $1.00/$5.00 per 1M in/out)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# SOEP-generatie (medische redenering, ICPC) op een sterker model; ~1 cent per SOEP.
# Opschonen en nazorg blijven op ANTHROPIC_MODEL (Haiku).
ANTHROPIC_SOEP_MODEL=claude-sonnet-5
# Denkdiepte op Sonnet 5: low (snelst) | medium | high
ANTHROPIC_EFFORT=medium
# Google Gemini Flash (~€0.000075/1K tokens)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5
