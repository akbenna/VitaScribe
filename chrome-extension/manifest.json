{
  "manifest_version": 3,
  "name": "VitaScribe — AI Consultassistent",
  "version": "2.32.0",
  "description": "Dicteren, SOEP, tolk, brieven en dossiervragen voor Bricks Huisarts",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "offscreen",
    "sidePanel",
    "clipboardWrite",
    "scripting",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://*.bfrcloud.com/*",
    "https://*.bfrnet.nl/*",
    "https://*.bricks-huisarts.nl/*",
    "https://*.bfrw.nl/*",
    "https://*.bfrw.cloud/*",
    "https://*.brickshuisarts.nl/*",
    "https://*.bfrw-online.nl/*",
    "https://*.bricks.nl/*",
    "https://*.bricks-his.nl/*",
    "http://localhost:8002/*",
    "https://*.up.railway.app/*"
  ],
  "action": {
    "default_title": "VitaScribe — AI Consultassistent",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "Dicteren starten/stoppen"
    },
    "toggle-consult": {
      "suggested_key": {
        "default": "Alt+Shift+C",
        "mac": "Alt+Shift+C"
      },
      "description": "Consultopname starten/stoppen (starten = patiënt geeft toestemming)"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bfrcloud.com/*",
        "https://*.bfrnet.nl/*",
        "https://*.bricks-huisarts.nl/*",
        "https://*.bfrw.nl/*",
        "https://*.bfrw.cloud/*",
        "https://*.brickshuisarts.nl/*",
        "https://*.bfrw-online.nl/*",
        "http://localhost:8002/*"
      ],
      "js": [
        "lib/praktijk.js",
        "content/bricks.js"
      ],
      "css": [
        "content/bricks.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/dictation-target.js",
        "content/foto-upload.js",
        "content/klikfocus.js"
      ],
      "all_frames": true,
      "run_at": "document_idle",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
