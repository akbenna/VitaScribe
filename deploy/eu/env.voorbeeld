# Kopieer naar .env en vul in. Zet .env nooit in git.
# Namen gelijk aan Railway; de waarden kopieer je zelf uit Railway > Variables.

# Domein dat naar dit IP-adres wijst (A-record), bijv. vitascribe-eu.provita-care.nl
VITASCRIBE_DOMEIN=
POSTGRES_PASSWORD=

# Deze server is voor de EU-modus: de Claude-modus weigert hij (Railway houdt die open).
TOEGESTANE_MODI=eu
VITASCRIBE_FASE=intern

# Sleutels van de artsen: dezelfde regel als op Railway, dan werkt dezelfde sleutel op beide.
API_USERS=
ADMIN_KEY=
ADMIN_TOTP=
APP_SECRET_KEY=

# Mistral (EU): spraak, tekst, voorlezen
MISTRAL_API_KEY=
EU_LLM_PROVIDER=mistral

# Optioneel, zoals op Railway
SLEUTELKLUIS=
CLINICAL_DECISION_SUPPORT=false
ECONSULT_NHG_IN_EU=false
