# =============================================================================
# VitaScribe - PRODUCTIE op eigen GPU-server (on-premise, privacy-first)
# =============================================================================
# Kopieer naar .env op de praktijkserver en vul de <...> in.
# Alles lokaal: geen patiëntdata naar de cloud (conform NEN 7510 / AVG).
#
# Genereer geheimen met:  openssl rand -hex 32
# =============================================================================

# --- Applicatie ---
APP_ENV=production
APP_LOG_LEVEL=WARNING
APP_SECRET_KEY=<genereer-32-byte-hex>
DB_ENCRYPTION_KEY=<genereer-32-byte-hex>

# --- Database (Docker Compose levert de hostnaam 'postgres') ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=consultassistent
POSTGRES_USER=ca_app
POSTGRES_PASSWORD=<kies-sterk-wachtwoord>

# --- Redis (Docker Compose levert 'redis') ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<kies-sterk-wachtwoord>

# --- Whisper (STT) - GPU ---
WHISPER_DEVICE=cuda
WHISPER_MODEL=large-v3-turbo
WHISPER_COMPUTE_TYPE=float16
WHISPER_MODEL_PATH=/models/whisper
WHISPER_LANGUAGE=nl
WHISPER_BEAM_SIZE=5
# Medische context + naberekening (onze upgrades) - laat aan
WHISPER_USE_INITIAL_PROMPT=true
WHISPER_USE_HOTWORDS=true
WHISPER_POSTCORRECT=true
WHISPER_CUSTOM_VOCAB_PATH=/data/vocabulary/custom_vocabulary.json
# Forced alignment (WhisperX) - optioneel, vereist extra model; later aanzetten
WHISPER_USE_FORCED_ALIGNMENT=false
WHISPER_ALIGNMENT_DEVICE=cuda

# --- Diarisatie (PyAnnote) - sprekerscheiding arts/patiënt ---
DIARIZATION_ENABLED=true
# HuggingFace-token nodig voor model-download (accepteer de modelvoorwaarden op HF)
HF_TOKEN=<je-huggingface-token>

# --- Ollama (lokaal LLM, Docker Compose levert 'ollama') ---
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=120

# --- Cloud fallback: UIT (privacy-first) ---
CLOUD_FALLBACK_ENABLED=false

# --- Zelflerende laag (onze upgrades) ---
FEWSHOT_ENABLED=true
FEWSHOT_BANK_PATH=/data/fewshot/soep_examples.json
FEWSHOT_K=3
FEWSHOT_MAX_EXAMPLES=500
VOCAB_LEARN_MIN_CONFIRMATIONS=3
VOCAB_LEARN_MIN_DOMINANCE=0.6
VOCAB_LEARN_PERSIST_FLOOR=2

# --- Audio / audit ---
AUDIO_STORAGE_PATH=/data/audio
AUDIO_MAX_DURATION_SECONDS=3600
AUDIT_LOG_RETENTION_YEARS=5

# --- HIS-export (Bricks/HIS) - vul in indien van toepassing ---
HIS_DEFAULT_TARGET=clipboard

# --- Beveiliging / CORS - alleen de eigen frontend toestaan ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
SESSION_TIMEOUT_MINUTES=30
MAX_LOGIN_ATTEMPTS=5

# --- Eerste keer: gebruikers seeden (daarna op false zetten) ---
SEED_ON_START=true
ADMIN_PASSWORD=<kies-sterk-wachtwoord>
ARTS_PASSWORD=<kies-sterk-wachtwoord>
